// Local emulator fixtures only. These rules are not deployment rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document=**} {
      allow read, write: if !(collection in [
        'notificationAccountLinks', 'notificationLotteryOwners', 'lotteryNotifications'
      ]);
    }
  }
}
